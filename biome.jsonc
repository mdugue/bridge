{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next",
    "ultracite/biome/vitest"
  ],
  "overrides": [
    {
      "includes": ["data/**"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    },
    {
      // Static assets served as-is (the default Next.js boilerplate SVGs).
      // Not app source — the JSX a11y rules (e.g. noSvgWithoutTitle) don't
      // apply to standalone files in public/.
      "includes": ["public/**"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    },
    {
      // Standalone CDN-loaded shader playground (not part of the app build):
      // mirrors the city scene's tree/building tuning in isolation. Uses a
      // namespace three import + terse inline scratch code on purpose.
      "includes": ["aesthetic-sandbox.html"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    },
    {
      // Vendored agent skills under .agents/skills (symlinked from
      // .claude/skills), pinned by skills-lock.json. Third-party content —
      // never lint or format it; re-add/update instead.
      "includes": [".agents/**"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    },
    {
      // Bun unit tests (`*.test.ts`, colocated next to source). Inline regex
      // assertions read more clearly and the hoisting perf gain is irrelevant
      // in a test process — same rationale as the e2e block below.
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      // E2E specs read more clearly with inline regex assertions; the
      // perf gain from hoisting them is irrelevant in a test process.
      "includes": ["e2e/**", "playwright.config.ts"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          },
          "style": {
            "noNestedTernary": "off"
          }
        }
      }
    },
    {
      "includes": ["components/ui/**", "hooks/use-mobile.ts"],
      "linter": {
        "rules": {
          "a11y": {
            "useFocusableInteractive": "off",
            "useSemanticElements": "off",
            "noStaticElementInteractions": "off",
            "noNoninteractiveElementInteractions": "off",
            "noSvgWithoutTitle": "off",
            "useKeyWithClickEvents": "off",
            "useAriaPropsForRole": "off",
            "noLabelWithoutControl": "off",
            "noRedundantRoles": "off"
          },
          "correctness": {
            "noNestedComponentDefinitions": "off",
            "useUniqueElementIds": "off",
            "useExhaustiveDependencies": "off"
          },
          "performance": {
            "noNamespaceImport": "off",
            "noBarrelFile": "off",
            "noReExportAll": "off"
          },
          "style": {
            "useConsistentTypeDefinitions": "off",
            "noNestedTernary": "off",
            "useNamingConvention": "off",
            "useComponentExportOnlyModules": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noExplicitAny": "off",
            "noDoubleEquals": "off",
            "noDocumentCookie": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    }
  ]
}
