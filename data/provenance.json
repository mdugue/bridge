      "extract": "sachsen-260615.osm.pbf (Geofabrik, 2026-06-15)",
      "products": {
        "walls": { "query": "barrier in (retaining_wall, city_wall, wall) or man_made=embankment", "dataAsOf": "2026-06-15 (re-baked 2026-09-24 by the Python pipeline; identical geometry)" },
        "lamps": { "query": "highway=street_lamp", "dataAsOf": "2026-06-15 (re-baked 2026-09-24 by the Python pipeline; the same lamps as the Overpass bake)" },
        "platforms": { "query": "railway=platform, or public_transport=platform on a railway feature; each platform owned by the tile its centroid lies in", "dataAsOf": "2026-06-15 (re-baked 2026-09-24)" },
        "bridgeStructure": { "query": "man_made=bridge bridge:structure", "dataAsOf": "2026-06-15 (re-baked 2026-09-24)" }
      }
    },
    "bbbike": {
      "$comment": "City extract used where download.geofabrik.de is unreachable (it resets connections from the Claude Code cloud container). Same OSM data and licence, cut to a bounding box (13.43–14.18 E, 50.88–51.23 N) that covers every Dresden tile; osm.py reads whichever .osm.pbf under osm/ is newest.",
      "download": "https://download.bbbike.org/osm/bbbike/Dresden/Dresden.osm.pbf",
