{
  "name": "bridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun scripts/prepare-data.ts && next dev",
    "build": "bun scripts/prepare-data.ts && next build",
    "start": "next start",
    "lint": "oxlint --max-warnings=0 && oxfmt --check",
    "typecheck": "tsc --noEmit",
    "fix": "oxfmt && oxlint --fix",
    "test": "bun test ./lib ./app ./scripts",
    "test:watch": "bun test ./lib ./app ./scripts --watch",
    "test:coverage": "bun test ./lib ./app ./scripts --coverage",
    "test:e2e": "playwright test",
    "shots": "SHOTS=1 playwright test e2e/snapshot-shot.spec.ts --headed",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "docs:diagrams": "bun scripts/render-diagrams.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@shikijs/rehype": "^4.4.3",
    "@types/three": "0.186.0",
    "cityjson-threejs-loader": "0.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^1.47.0",
    "n8ao": "2.0.1",
    "next": "16.3.5",
    "postprocessing": "6.39.5",
    "proj4": "2.22.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "suncalc": "2.0.2",
    "three": "0.186.0",
    "three-mesh-bvh": "0.9.15",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "delatin": "^0.2.0",
    "geotiff": "^3.0.5",
    "mermaid": "^12.0.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "cityjson-threejs-loader@0.4.0": "patches/cityjson-threejs-loader@0.4.0.patch"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
