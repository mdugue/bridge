{
  "name": "bridge",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun scripts/copy-wasm.ts && bun scripts/prepare-sites.ts && next dev --experimental-https",
    "build": "bun scripts/copy-wasm.ts && bun scripts/prepare-sites.ts && next build && NODE_ENV=production bun scripts/sentry-release.ts",
    "start": "next start",
    "lint": "oxlint --max-warnings=0 && oxfmt --check",
    "typecheck": "bun check",
    "typecheck:tsc": "tsc --noEmit",
    "fix": "oxfmt && oxlint --fix",
    "test": "bun test --parallel ./lib ./app ./scripts",
    "test:watch": "bun test --isolate ./lib ./app ./scripts --watch",
    "test:coverage": "bun test --parallel ./lib ./app ./scripts --coverage",
    "test:e2e": "playwright test",
    "shots": "SHOTS=1 playwright test e2e/snapshot-shot.spec.ts --headed",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "docs:diagrams": "bun scripts/render-diagrams.ts",
    "docs:matrix": "bun scripts/docs-matrix.ts",
    "site": "bun scripts/site-report.ts",
    "fetch": "bun scripts/pipeline.ts fetch",
    "bake": "bun scripts/pipeline.ts bake",
    "test:pipeline": "cd pipeline && uv run pytest -q tests && uv run ruff check . && uv run ruff format --check ."
  },
  "dependencies": {
    "3d-tiles-renderer": "0.5.3",
    "@base-ui/react": "^1.9.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.3",
    "@shikijs/rehype": "^4.5.0",
    "@types/three": "0.187.0",
    "cityjson-threejs-loader": "0.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rhino3dm": "8.32.1",
    "suncalc": "2.1.1",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.17",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "web-ifc": "^0.0.78"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "delatin": "0.2.0",
    "delaunator": "^5.1.0",
    "geotiff": "^3.0.5",
    "mermaid": "^12.2.0",
    "meshoptimizer": "1.3.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "polygon-clipping": "^0.15.7",
    "proj4": "2.22.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "cityjson-threejs-loader@0.4.0": "patches/cityjson-threejs-loader@0.4.0.patch"
  },
  "trustedDependencies": [
    "sharp"
  ]
}
