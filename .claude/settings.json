{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:www.geodaten.sachsen.de)",
      "Bash(ogr2ogr --version)",
      "Bash(bash scripts/extract-*.sh *)",
      "Read(//tmp/**)",
      "Bash(awk '{print $5}')",
      "Bash(grep -vE \"^\\\\s*$\")",
      "Bash(bun test *)",
      "Bash(bunx playwright *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "WebFetch(domain:www.landesvermessung.sachsen.de)",
      "Bash(grep -iE 'fetch|load|url|path|\\\\.json|\\\\.png|\\\\.tif|\\\\.geojson|`/')",
      "Edit(/.claude/skills/city-walker/**)",
      "Bash(ogrinfo *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
